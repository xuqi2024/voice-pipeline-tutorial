# TTS Service 环境变量模板
# 复制此文件为 .env，填入真实 API Key
# cp .env.example .env

# MiniMax API Key（必填）
# 在 https://platform.minimaxi.com 申请
MINIMAX_API_KEY=your_minimax_api_key_here

# 可选覆盖
# MINIMAX_BASE_URL=https://api.minimaxi.com  # 国内版（默认）
# MINIMAX_BASE_URL=https://api.minimax.io    # 国际版

# MINIMAX_MODEL=speech-01       # t2a_pro 端点使用（默认）
# MINIMAX_MODEL=speech-02       # t2a_pro 高质量版本
# MINIMAX_MODEL=speech-01-turbo # t2a_v2 端点（需升级计划）

# MINIMAX_ENDPOINT=t2a_pro      # 默认：按次计费，兼容性最广
# MINIMAX_ENDPOINT=t2a_v2       # 流式输出（需升级至 Turbo/HD 计划）

# DEFAULT_VOICE=female-shaonv
# DEFAULT_SAMPLE_RATE=32000
